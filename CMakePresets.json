{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "MSVC x64 — ordinary builds",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo",
        "REALITY_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "windows-asan",
      "inherits": "windows-msvc",
      "displayName": "MSVC x64 — AddressSanitizer",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "REALITY_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug", "jobs": 2},
    {"name": "windows-release", "configurePreset": "windows-msvc", "configuration": "RelWithDebInfo", "jobs": 2},
    {"name": "windows-asan", "configurePreset": "windows-asan", "configuration": "RelWithDebInfo", "jobs": 2}
  ],
  "testPresets": [
    {"name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug", "output": {"outputOnFailure": true}, "execution": {"jobs": 1, "noTestsAction": "error"}},
    {"name": "windows-release", "configurePreset": "windows-msvc", "configuration": "RelWithDebInfo", "output": {"outputOnFailure": true}, "execution": {"jobs": 1, "noTestsAction": "error"}},
    {"name": "windows-asan", "configurePreset": "windows-asan", "configuration": "RelWithDebInfo", "output": {"outputOnFailure": true}, "execution": {"jobs": 1, "noTestsAction": "error"}}
  ]
}
